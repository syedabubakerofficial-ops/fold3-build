diff --git a/app/src/main/java/org/duofold/live/SensorAngles.kt b/app/src/main/java/org/duofold/live/SensorAngles.kt
new file mode 100644
index 0000000..d8867fa
--- /dev/null
+++ b/app/src/main/java/org/duofold/live/SensorAngles.kt
@@ -0,0 +1,68 @@
+package org.duofold.live
+
+import android.content.Context
+import android.hardware.Sensor
+import android.hardware.SensorEvent
+import android.hardware.SensorEventListener
+import android.hardware.SensorManager
+import android.os.Handler
+import android.os.Looper
+
+/**
+ * Experimental angle source for phones that lack Samsung's FoldInteractive wallpaper (Galaxy Z Fold3).
+ * Feeds the public TYPE_HINGE_ANGLE sensor into [LiveAngles], so the renderers see the same angle stream.
+ * No Shizuku is needed for the angle itself.
+ */
+class SensorAngles(context: Context) : SensorEventListener {
+    private val manager: SensorManager? = context.getSystemService(SensorManager::class.java)
+    private val main = Handler(Looper.getMainLooper())
+    private val tracker = HingeTracker(HingeCapability.POSTURE_ONLY)
+    private var registered = false
+
+    // The hinge sensor reports only when the angle changes, but LiveAngles.fresh() expires after 750 ms.
+    // While the sensor is registered and an angle is known, keep the latest reading fresh (no listener callbacks).
+    private val keepAlive = object : Runnable {
+        override fun run() {
+            if (!registered) return
+            LiveAngles.keepSensorFresh()
+            main.postDelayed(this, KEEP_ALIVE_MS)
+        }
+    }
+
+    val running: Boolean get() = registered
+
+    /** True when the sensor is registered. False when the device exposes no hinge-angle sensor. */
+    fun start(): Boolean {
+        if (registered) return true
+        val m = manager ?: return false
+        val sensor = m.getDefaultSensor(Sensor.TYPE_HINGE_ANGLE) ?: return false
+        registered = m.registerListener(this, sensor, SensorManager.SENSOR_DELAY_FASTEST, 0, main)
+        if (registered) {
+            RecoveryLog.add("Hinge sensor angle source started: ${sensor.name}")
+            main.post(keepAlive)
+        }
+        return registered
+    }
+
+    fun stop() {
+        if (!registered) return
+        registered = false
+        manager?.unregisterListener(this)
+        main.removeCallbacks(keepAlive)
+        LiveAngles.sensorStopped()
+        RecoveryLog.add("Hinge sensor angle source stopped")
+    }
+
+    override fun onSensorChanged(event: SensorEvent) {
+        if (event.sensor.type != Sensor.TYPE_HINGE_ANGLE || event.values.isEmpty()) return
+        val raw = event.values[0]
+        tracker.feed(raw, event.timestamp)
+        LiveAngles.publishSensorAngle(tracker.visual ?: raw, tracker.capability.name.lowercase())
+    }
+
+    override fun onAccuracyChanged(sensor: Sensor?, accuracy: Int) {}
+
+    private companion object {
+        const val KEEP_ALIVE_MS = 200L
+    }
+}
