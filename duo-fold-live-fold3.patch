+ /** Hinge-sensor mode (no Shizuku reader): publish one reading to the same listeners the wallpaper reader feeds. Main thread. */
+ public static void publishSensorAngle(float value,String capability){
+  angle=value;last=SystemClock.elapsedRealtime();sensorCapability=capability;
+  for(Listener l:new ArrayList<>(listeners))l.angle(value,last*1000000L);
